@using GlobalFests.Helpers
@model GlobalFests.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Register";
}
@using Microsoft.AspNetCore.Mvc.Localization
@using GlobalFests.Helpers
@inject IHtmlLocalizer<SharedResource> Localizer
<div class="page-container auth-wrapper">
    <div class="glass-panel auth-box" style="max-width: 600px;">
        <h2 class="form-title"><i class="fas fa-user-plus"></i>@Localizer["Create Account"]</h2>

        <form asp-action="Register" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-group">
                <label asp-for="User.Username" class="form-label"> @Localizer["Username"]</label>
                <div class="custom-input-group">
                    <i class="fas fa-user input-icon"></i>
                    <input asp-for="User.Username" class="form-control-custom" placeholder="Choose a username" autofocus />
                </div>
                <span asp-validation-for="User.Username" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="User.Email" class="form-label">Email</label>
                <div class="custom-input-group">
                    <i class="fas fa-envelope input-icon"></i>
                    <input asp-for="User.Email" class="form-control-custom" placeholder="Enter your email" type="email" />
                </div>
                <span asp-validation-for="User.Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="User.Password" class="form-label">@Localizer["Password"]</label>
                <div class="custom-input-group">
                    <i class="fas fa-lock input-icon"></i>
                    <input asp-for="User.Password" class="form-control-custom" placeholder="Create a strong password" type="password" />
                </div>
                <span asp-validation-for="User.Password" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="User.ConfirmPassword" class="form-label">@Localizer["Confirm Password"]</label>
                <div class="custom-input-group">
                    <i class="fas fa-lock input-icon"></i>
                    <input asp-for="User.ConfirmPassword" class="form-control-custom" placeholder="Confirm your password" type="password" />
                </div>
                <span asp-validation-for="User.ConfirmPassword" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="User.CountryId" class="form-label">@Localizer["Country"]</label>
                <div class="custom-input-group">
                    <i class="fas fa-globe input-icon"></i>
                    <select asp-for="User.CountryId" class="form-control-custom">
                        <option value="">-- Select your country (optional) --</option>
                        @if (Model.Countries != null)
                        {
                            foreach (var country in Model.Countries)
                            {
                                <option value="@country.Id">@country.CountryName</option>
                            }
                        }
                    </select>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="User.RoleId" class="form-label">@Localizer["Role"]</label>
                <div class="custom-input-group">
                    <i class="fas fa-globe input-icon"></i>
                    <select asp-for="User.RoleId" class="form-control-custom">
                        @if (Model.Roles != null)
                        {
                            foreach (var role in Model.Roles)
                            {
                                if(role.Id == (int)UserRole.User)
                                {
                                    <option value="@role.Id" selected>@role.Role1</option>
                                }
                                else
                                {
                                    <option value="@role.Id">@role.Role1</option>
                                }
                               
                            }
                        }
                    </select>
                </div>
            </div>

            <button type="submit" class="btn-main" style="background: #3d5af1; color: white;">
                @Localizer["CREATE ACCOUNT UPPER"]
            </button>

            <div class="auth-links">
                <p> @Localizer["Already have an account?"] <a asp-action="Login">@Localizer["Login here"]</a></p>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<partial name="_ValidationScriptsPartial" />
 }