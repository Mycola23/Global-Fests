{
    ViewData["Title"] = "Access Denied";
}

<div class="container page-container" style="display: flex; justify-content: center; align-items: center; min-height: 70vh;">

    <!-- Centered Glass Card -->
    <div class="dash-glass-card error-card">

        <!-- Animated Icon -->
        <div class="icon-wrapper">
            <i class="fas fa-lock"></i>
        </div>

        <h1 class="error-title">Access Denied</h1>
        <p class="error-text">
            Sorry, you don't have permission to view this page.<br />
            This area is restricted to authorized roles only.
        </p>

        <!-- Action Buttons -->
        <div class="error-actions">
            <a asp-controller="Home" asp-action="Index" class="btn-dash btn-cyan">
                <i class="fas fa-home"></i> Go Home
            </a>

            <a asp-controller="Account" asp-action="Login" class="btn-dash" style="border: 1px solid #666; color: #ccc;">
                <i class="fas fa-sign-in-alt"></i> Login with different account
            </a>
        </div>

        <div class="error-code">Error 403</div>
    </div>

</div>
