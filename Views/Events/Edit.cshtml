@using GlobalFests.Helpers
@model GlobalFests.ViewModels.EditEventsViewModel

<div class="page-container">
    <div class="create-grid">
        @*left form*@
        <div class="glass-panel">
            <h2 class="form-title" style="justify-content: flex-start;">
                <i class="fas fa-edit" style="color: var(--accent-cyan);"></i> Edit Event: @Model.Event.Title
            </h2>

            <form asp-action="Edit" method="post">
                <div asp-validation-summary="All" class="text-danger" style="margin-bottom: 20px;"></div>


                <input type="hidden" asp-for="Event.Id" />
                <input type="hidden" asp-for="Event.OrganizerId" />

                <div class="form-group">
                    <label asp-for="Event.Title" class="form-label">Event Title *</label>
                    <div class="custom-input-group">
                        <input asp-for="Event.Title" class="form-control-custom" required />
                    </div>
                    <span asp-validation-for="Event.Title" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Event.Description" class="form-label">Description</label>
                    <div class="custom-input-group textarea-wrapper">
                        <i class="fas fa-align-left input-icon"></i>
                        <textarea asp-for="Event.Description" class="form-control-custom" rows="4"></textarea>
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                    <div class="form-group">
                        <label asp-for="Event.StartDate" class="form-label">Start Date *</label>
                        <div class="custom-input-group">
                            <input asp-for="Event.StartDate" type="datetime-local" class="form-control-custom" required />
                        </div>
                    </div>
                    <div class="form-group">
                        <label asp-for="Event.EndDate" class="form-label">End Date *</label>
                        <div class="custom-input-group">
                            <input asp-for="Event.EndDate" type="datetime-local" class="form-control-custom" required />
                        </div>
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                    <div class="form-group">
                        <label asp-for="Event.TypeId" class="form-label">Event Type *</label>
                        <div class="custom-input-group">
                            <select asp-for="Event.TypeId" class="form-control-custom" required>
                                @foreach (var type in Model.EventTypes)
                                {
                                    <option value="@type.Id">@type.Type</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="form-group">
                        <label asp-for="Event.CountryId" class="form-label">Country *</label>
                        <div class="custom-input-group">
                            <select asp-for="Event.CountryId" class="form-control-custom" required>
                                @foreach (var country in Model.Countries)
                                {
                                    <option value="@country.Id">@country.CountryName</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                    <div class="form-group">
                        <label asp-for="Event.City" class="form-label">City</label>
                        <div class="custom-input-group">
                            <input asp-for="Event.City" class="form-control-custom" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label asp-for="Event.Address" class="form-label">Address</label>
                        <div class="custom-input-group">
                            <input asp-for="Event.Address" class="form-control-custom" />
                        </div>
                    </div>
                </div>

                <hr style="border-color: rgba(255,255,255,0.1); margin: 20px 0;" />

                <h3 style="color:white; font-size:18px; margin-bottom:15px;">Ticketing & Media</h3>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                    <div class="form-group">
                        <label asp-for="Event.TicketPrice" class="form-label">Price ($)</label>
                        <div class="custom-input-group">
                            <input asp-for="Event.TicketPrice" type="number" step="0.01" class="form-control-custom"
                                   readonly="@(Model.HasSoldTickets ? "readonly" : null)"
                                   style="@(Model.HasSoldTickets ? "opacity: 0.5; cursor: not-allowed;" : "")" />
                            @if (Model.HasSoldTickets)
                            {
                                <span class="text-warning" style="font-size: 12px;">Price cannot be changed because tickets have been sold.</span>
                            }
                        </div>
                    </div>
                    <div class="form-group">
                        <label asp-for="Event.TicketAmount" class="form-label">Total Tickets *</label>
                        <div class="custom-input-group">
                            <input asp-for="Event.TicketAmount" type="number" class="form-control-custom" required />
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="Event.Poster" class="form-label">Poster URL</label>
                    <div class="custom-input-group">
                        <i class="fas fa-image input-icon"></i>
                        <input asp-for="Event.Poster" class="form-control-custom" />
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Genres</label>
                    <div class="custom-input-group select-multiple-wrapper">
                        <i class="fas fa-music input-icon" style="margin-top: 12px;"></i>
                        <select asp-for="SelectedGenreIds" class="select-multiple" multiple="multiple">
                            @foreach (var genre in Model.Genres)
                            {
                                <option value="@genre.Id">@genre.Genre1</option>
                            }
                        </select>
                    </div>
                    <span class="select-hint"><i class="fas fa-info-circle"></i> Hold Ctrl/Cmd to reselect genres.</span>
                </div>
                <!-- Performers Section  -->
                <div class="form-group">
                    <label class="form-label">Manage Performers</label>

                    <!--  search performer -->
                    <div class="custom-input-group" style="margin-bottom: 15px;">
                        <i class="fas fa-search input-icon"></i>
                        <input type="text" id="performerSearch" class="form-control-custom" placeholder="Search to add performers..." />
                    </div>

                    <!-- performer list -->
                    <div id="performersContainer" class="performers-selection-grid">
                       
                    </div>

                    <!-- load more -->
                    <div style="text-align: center; margin-top: 10px;">
                        <button type="button" id="btnLoadMorePerformers" class="btn-dash btn-cyan" style="width: auto; padding: 5px 15px; display: none;">
                            Load More <i class="fas fa-chevron-down" style="margin-left: 5px;"></i>
                        </button>
                    </div>

                   
                    <div id="selectedPerformersInputs">
                        @foreach (var id in Model.SelectedPerformerIds)
                        {
                            <input type="hidden" name="SelectedPerformerIds" value="@id" id="perf_input_@id" />
                        }
                    </div>
                </div>
                <div style="display: flex; gap: 15px; margin-top: 30px;">
                    <a asp-controller="Organizer" asp-action="Index" class="btn-main btn-secondary-custom">Cancel</a>
                    <button type="submit" class="btn-main">Save Changes</button>
                </div>
            </form>
        </div>
        @*right*@
        <div>
            @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
            {
                <a asp-controller="Admin" asp-action="Events" class="btn-dash btn-cyan" style="margin-bottom: 20px;">Back to panel</a>
            }
            else
            {
                <a asp-controller="Organizer" asp-action="Index" class="btn-dash btn-cyan" style="margin-bottom: 20px;">Back to panel</a>
            }
            <div class="guidelines-card">
                <h3 style="color:var(--accent-cyan); margin-bottom:15px;"><i class="fas fa-info-circle"></i> Editing Tips</h3>
                <ul class="guidelines-list">
                    <li><i class="fas fa-history"></i> <span>Changing the date might affect already sold tickets.</span></li>
                    <li><i class="fas fa-eye"></i> <span>Your event will stay approved unless you change key info.</span></li>
                </ul>
            </div>
            @if(Model.Event.Status == (int)Status.Rejected)
            {
                <div class="guidelines-card">
                    <h3 style="color:var(--warning-color); margin-bottom:15px;"><i class="fas fa-info-circle"></i> Rejectin Reason</h3>
                    <div class="guidelines__text">
                        @Model.Event.RejectionReason
                    </div>
                </div>
            }
           

        </div>
    </div>
</div>

@section Styles {
    <style>
        .performers-selection-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 10px;
            max-height: 300px;
            overflow-y: auto;
            padding-right: 5px;
        }

        .performer-select-card {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 8px;
            padding: 10px;
            display: flex;
            align-items: center;
            cursor: pointer;
            transition: all 0.2s;
            position: relative;
        }

            .performer-select-card:hover {
                background: rgba(255, 255, 255, 0.1);
            }


            .performer-select-card.selected {
                border-color: var(--accent-cyan);
                background: rgba(180, 248, 200, 0.1);
                box-shadow: 0 0 10px rgba(180, 248, 200, 0.1);
            }

            .performer-select-card img {
                width: 40px;
                height: 40px;
                border-radius: 50%;
                margin-right: 10px;
                object-fit: cover;
            }

        .performer-name {
            font-size: 14px;
            color: white;
            font-weight: 500;
        }

        .check-icon {
            position: absolute;
            top: 8px;
            right: 8px;
            color: var(--accent-cyan);
            opacity: 0;
            transition: opacity 0.2s;
        }

        .performer-select-card.selected .check-icon {
            opacity: 1;
        }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const searchInput = document.getElementById('performerSearch');
            const container = document.getElementById('performersContainer');
            const loadMoreBtn = document.getElementById('btnLoadMorePerformers');
            const inputsContainer = document.getElementById('selectedPerformersInputs');

            let currentCursorDate = null;
            let currentCursorId = null;
            let isLoading = false;

            
            let selectedIds = new Set(@Html.Raw(Json.Serialize(Model.SelectedPerformerIds)));

            
            function loadPerformers(reset = false) {
                if (isLoading) return;
                isLoading = true;

                const query = searchInput.value;
                let url = `/Events/GetPerformersJson?search=${encodeURIComponent(query)}`;

                if (!reset && currentCursorDate && currentCursorId) {
                    url += `&cursorDate=${currentCursorDate}&cursorId=${currentCursorId}`;
                }

                fetch(url)
                    .then(res => res.json())
                    .then(data => {
                        if (reset) container.innerHTML = '';

                        if (data.items && data.items.length > 0) {
                            data.items.forEach(p => {
                                const card = createPerformerCard(p);
                                container.appendChild(card);
                            });

                            if (data.hasNextPage) {
                                currentCursorDate = data.nextCursorDate;
                                currentCursorId = data.nextCursorId;
                                loadMoreBtn.style.display = 'inline-block';
                            } else {
                                loadMoreBtn.style.display = 'none';
                            }
                        } else if (reset) {
                            container.innerHTML = '<p style="color:#888; text-align:center; grid-column: 1/-1;">No performers found.</p>';
                            loadMoreBtn.style.display = 'none';
                        }
                        isLoading = false;
                    })
                    .catch(err => {
                        console.error(err);
                        isLoading = false;
                    });
            }

           
            function createPerformerCard(performer) {
                const div = document.createElement('div');
                div.className = 'performer-select-card';
                div.dataset.id = performer.id;

               
                if (selectedIds.has(performer.id)) {
                    div.classList.add('selected');
                }

                const imgUrl = performer.avatar ? performer.avatar : `https://ui-avatars.com/api/?name=${performer.name}&background=random`;

                div.innerHTML = `
                    <img src="${imgUrl}" alt="${performer.name}">
                    <div class="performer-name">${performer.name}</div>
                    <i class="fas fa-check-circle check-icon"></i>
                `;

                div.addEventListener('click', function () {
                    const id = parseInt(this.dataset.id);

                    if (selectedIds.has(id)) {
                        selectedIds.delete(id);
                        this.classList.remove('selected');
                        removeInput(id);
                    } else {
                        selectedIds.add(id);
                        this.classList.add('selected');
                        addInput(id);
                    }
                });

                return div;
            }

            function addInput(id) {
               
                if (!document.getElementById(`perf_input_${id}`)) {
                    const input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = 'SelectedPerformerIds';
                    input.value = id;
                    input.id = `perf_input_${id}`;
                    inputsContainer.appendChild(input);
                }
            }

            function removeInput(id) {
                const input = document.getElementById(`perf_input_${id}`);
                if (input) input.remove();
            }

            
            let debounceTimer;
            searchInput.addEventListener('input', function () {
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(() => {
                    currentCursorDate = null;
                    currentCursorId = null;
                    loadPerformers(true);
                }, 500);
            });

            loadMoreBtn.addEventListener('click', function () {
                loadPerformers(false);
            });

          
            loadPerformers(true);
        });
    </script>
}
