
@model GlobalFests.ViewModels.CreateEventsViewModel;


<div class="page-container">
    <div class="create-grid">
        @*left form*@
        <div class="glass-panel">
            <h2 class="form-title" style="justify-content: flex-start;">
                <i class="fas fa-calendar-plus" style="color: var(--accent-cyan);"></i> Create New Event
            </h2>

            <form asp-action="Create" method="post">
                <div asp-validation-summary="All" class="text-danger" style="margin-bottom: 20px;"></div>

                <div class="form-group">
                    <label asp-for="NewEvent.Title" class="form-label">Event Title *</label>
                    <div class="custom-input-group">
                        <input asp-for="NewEvent.Title" class="form-control-custom" placeholder="Enter event title" required />
                    </div>
                    <span asp-validation-for="NewEvent.Title" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="NewEvent.Description" class="form-label">Description</label>
                    <div class="custom-input-group textarea-wrapper">
                        <i class="fas fa-align-left input-icon"></i>
                        <textarea asp-for="NewEvent.Description" class="form-control-custom" rows="4" placeholder="Describe your event"></textarea>
                    </div>
                    <span asp-validation-for="NewEvent.Description" class="text-danger"></span>
                </div>
                @*Two columns grid for date/location inside form*@
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                    <div class="form-group">
                        <label asp-for="NewEvent.StartDate" class="form-label">Start Date *</label>
                        <div class="custom-input-group">
                            <input asp-for="NewEvent.StartDate" type="datetime-local" step="60" class="form-control-custom" required />
                        </div>
                    </div>
                    <div class="form-group">
                        <label asp-for="NewEvent.EndDate" class="form-label">End Date *</label>
                        <div class="custom-input-group">
                            <input asp-for="NewEvent.EndDate" type="datetime-local" step="60" class="form-control-custom" required />
                        </div>
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                    <div class="form-group">
                        <label asp-for="NewEvent.TypeId" class="form-label">Event Type *</label>
                        <div class="custom-input-group">
                            <select asp-for="NewEvent.TypeId" class="form-control-custom" required>
                                <option value="">-- Select Type --</option>
                                @if (Model.EventTypes != null)
                                {
                                    @foreach (var type in Model.EventTypes)
                                    {
                                        <option value="@type.Id">@type.Type</option>
                                    }
                                }
                            </select>
                           
                        </div>
                        <span asp-validation-for="NewEvent.TypeId" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="NewEvent.CountryId" class="form-label">Country *</label>
                        <div class="custom-input-group">
                            <select asp-for="NewEvent.CountryId" class="form-control-custom" required>
                                <option value="">-- Select Country --</option>
                                @if (Model.Countries != null)
                                {
                                    @foreach (var country in Model.Countries)
                                    {
                                        <option value="@country.Id">@country.CountryName</option>
                                    }
                                }
                            </select>
                           
                        </div>
                        <span asp-validation-for="NewEvent.CountryId" class="text-danger"></span>
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                    <div class="form-group">
                        <label asp-for="NewEvent.City" class="form-label">City</label>
                        <div class="custom-input-group">
                            <input asp-for="NewEvent.City" class="form-control-custom" placeholder="City name" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label asp-for="NewEvent.Address" class="form-label">Address</label>
                        <div class="custom-input-group">
                            <input asp-for="NewEvent.Address" class="form-control-custom" placeholder="Street address" />
                        </div>
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                    <div class="form-group">
                        <label asp-for="NewEvent.Latitude" class="form-label">Latitude</label>
                        <div class="custom-input-group">
                            <input asp-for="NewEvent.Latitude" type="number" step="0.000001" class="form-control-custom" placeholder="e.g. 40.7128" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label asp-for="NewEvent.Longitude" class="form-label">Longitude</label>
                        <div class="custom-input-group">
                            <input asp-for="NewEvent.Longitude" type="number" step="0.000001" class="form-control-custom" placeholder="e.g. -74.0060" />
                        </div>
                    </div>
                </div>

                <hr style="border-color: rgba(255,255,255,0.1); margin: 20px 0;" />

                <h3 style="color:white; font-size:18px; margin-bottom:15px;">Ticket Information</h3>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                    <div class="form-group">
                        <label asp-for="NewEvent.TicketPrice" class="form-label">Price ($)</label>
                        <div class="custom-input-group">
                            <input asp-for="NewEvent.TicketPrice" type="number" step="0.01" class="form-control-custom" placeholder="0.00" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label asp-for="NewEvent.TicketAmount" class="form-label">Quantity *</label>
                        <div class="custom-input-group">
                            <input asp-for="NewEvent.TicketAmount" type="number" min="1" class="form-control-custom" placeholder="100" required />
                        </div>
                        <span asp-validation-for="NewEvent.TicketAmount" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="NewEvent.Poster" class="form-label">Poster URL</label>
                    <div class="custom-input-group">
                        <i class="fas fa-image input-icon"></i>
                        <input asp-for="NewEvent.Poster" class="form-control-custom" placeholder="https://example.com/image.jpg" />
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">Genres (Select one or more)</label>
                    <div class="custom-input-group select-multiple-wrapper">
                        <i class="fas fa-music input-icon" style="margin-top: 12px;"></i>
                        <select asp-for="SelectedGenreIds" class="select-multiple"
                                multiple="multiple">
                            @if (Model.Genres != null)
                            {
                                @foreach (var genre in Model.Genres)
                                {
                                    <option value="@genre.Id">@genre.Genre1</option>
                                }
                            }
                        </select>
                    </div>
                    <span class="select-hint">
                        <i class="fas fa-info-circle"></i> Hold <b>Ctrl</b> (Win) or <b>Cmd</b> (Mac) to select multiple genres.
                    </span>
                    <span asp-validation-for="SelectedGenreIds" class="text-danger"></span>
                </div>
                <!-- Performers Section -->
                <div class="form-group">
                    <label class="form-label">Add Performers</label>

                    <!-- search performer -->
                    <div class="custom-input-group" style="margin-bottom: 15px;">
                        <i class="fas fa-search input-icon"></i>
                        <input type="text" id="performerSearch" class="form-control-custom" placeholder="Search performers by name..." />
                    </div>

                    <!-- performer list -->
                    <div id="performersContainer" class="performers-selection-grid">
                      
                    </div>

                    <!-- load more -->
                    <div style="text-align: center; margin-top: 10px;">
                        <button type="button" id="btnLoadMorePerformers" class="btn-dash btn-cyan" style="width: auto; padding: 5px 15px; display: none;">
                            Load More <i class="fas fa-chevron-down" style="margin-left: 5px;"></i>
                        </button>
                    </div>

                    
                    <div id="selectedPerformersInputs"></div>
                </div>
                <div style="display: flex; gap: 15px; margin-top: 30px;">
                    @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
                    {
                        <a asp-controller="Admin" asp-action="Events" class="btn-main btn-secondary-custom">Cancel</a>
                    }
                    else
                    {
                        <a asp-controller="Organizer" asp-action="Index" class="btn-main btn-secondary-custom">Cancel</a>
                    }
                   
                    <button type="submit" name="submitAction" value="Draft" class="btn-main btn-secondary-custom"  style="border: 1px solid var(--accent-cyan);">
                        <i class="fas fa-save"></i> Save as Draft
                    </button>
                    <button type="submit" name="submitAction" value="Submit" class="btn-main">Create Event</button>
                    
                </div>
            </form>
        </div>

        @*right info*@
        <div style="margin-top: 20px;">
            @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
            {
                <a asp-controller="Admin" asp-action="Events" class="btn-dash btn-cyan" style="margin-bottom: 20px;">Back to panel</a>
            }
            else
            {
                <a asp-controller="Organizer" asp-action="Index" class="btn-dash btn-cyan" style="margin-bottom: 20px;">Back to panel</a>
            } 
            <div class="guidelines-card">
                <h3 style="color:var(--accent-cyan); margin-bottom:15px;"><i class="fas fa-info-circle"></i> Guidelines</h3>
                <ul class="guidelines-list">
                    <li><i class="fas fa-check"></i> <span>Make the title clear and catchy.</span></li>
                    <li><i class="fas fa-check"></i> <span>Ensure start date is before end date.</span></li>
                    <li><i class="fas fa-check"></i> <span>Provide accurate coordinates for the map.</span></li>
                    <li><i class="fas fa-check"></i> <span>Set ticket price to 0 for free events.</span></li>
                </ul>
            </div>

            <div class="guidelines-card" style="margin-top: 20px; border-color: #ff9800; background: rgba(255, 152, 0, 0.05);">
                <p style="color: #ffb74d; font-size: 14px; margin: 0;">
                    <i class="fas fa-flag"></i> Your event will require approval before appearing publicly.
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const searchInput = document.getElementById('performerSearch');
            const container = document.getElementById('performersContainer');
            const loadMoreBtn = document.getElementById('btnLoadMorePerformers');
            const inputsContainer = document.getElementById('selectedPerformersInputs');

            let currentCursorDate = null;
            let currentCursorId = null;
            let isLoading = false;
            let selectedIds = new Set(); 

           
            function loadPerformers(reset = false) {
                if (isLoading) return;
                isLoading = true;

                const query = searchInput.value;
                let url = `/Events/GetPerformersJson?search=${encodeURIComponent(query)}`;

                if (!reset && currentCursorDate && currentCursorId) {
                    url += `&cursorDate=${currentCursorDate}&cursorId=${currentCursorId}`;
                }

                fetch(url)
                    .then(res => res.json())
                    .then(data => {
                        if (reset) container.innerHTML = '';

                        if (data.items && data.items.length > 0) {
                            data.items.forEach(p => {
                                const card = createPerformerCard(p);
                                container.appendChild(card);
                            });

                            // update cursor
                            if (data.hasNextPage) {
                                currentCursorDate = data.nextCursorDate;
                                currentCursorId = data.nextCursorId;
                                loadMoreBtn.style.display = 'inline-block';
                            } else {
                                loadMoreBtn.style.display = 'none';
                            }
                        } else if (reset) {
                            container.innerHTML = '<p style="color:#888; text-align:center; grid-column: 1/-1;">No performers found.</p>';
                            loadMoreBtn.style.display = 'none';
                        }
                        isLoading = false;
                    })
                    .catch(err => {
                        console.error(err);
                        isLoading = false;
                    });
            }

            
            function createPerformerCard(performer) {
                const div = document.createElement('div');
                div.className = 'performer-select-card';
                div.dataset.id = performer.id;

                    // restore selected state if this Id is already in  list
                if (selectedIds.has(performer.id)) {
                    div.classList.add('selected');
                }

                const imgUrl = performer.avatar ? performer.avatar : `https://ui-avatars.com/api/?name=${performer.name}&background=random`;

                div.innerHTML = `
    <img src="${imgUrl}" alt="${performer.name}">
    <div class="performer-name">${performer.name}</div>
    <i class="fas fa-check-circle check-icon"></i>
                `;

                // listener to choose performer
                div.addEventListener('click', function () {
                    const id = parseInt(this.dataset.id);

                    if (selectedIds.has(id)) {
                        selectedIds.delete(id);
                        this.classList.remove('selected');
                        removeInput(id);
                    } else {
                        selectedIds.add(id);
                        this.classList.add('selected');
                        addInput(id);
                    }
                });

                return div;
            }

            // hided input to send form on server
            function addInput(id) {
                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = 'SelectedPerformerIds'; 
                input.value = id;
                input.id = `perf_input_${id}`;
                inputsContainer.appendChild(input);
            }

            function removeInput(id) {
                const input = document.getElementById(`perf_input_${id}`);
                if (input) input.remove();
            }

            
            let debounceTimer;
            searchInput.addEventListener('input', function () {
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(() => {
                    currentCursorDate = null;
                    currentCursorId = null;
                    loadPerformers(true); // reset = true
                }, 500);
            });

            //btn load more ..  
            loadMoreBtn.addEventListener('click', function () {
                loadPerformers(false);
            });

            // load start performers
            loadPerformers(true);
        });
    </script>
 }

@section Styles {
    <style>
        .performers-selection-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 10px;
            max-height: 300px;
            overflow-y: auto;
            padding-right: 5px;
        }

        .performer-select-card {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 8px;
            padding: 10px;
            display: flex;
            align-items: center;
            cursor: pointer;
            transition: all 0.2s;
            position: relative;
        }

            .performer-select-card:hover {
                background: rgba(255, 255, 255, 0.1);
            }

           
            .performer-select-card.selected {
                border-color: var(--accent-cyan);
                background: rgba(180, 248, 200, 0.1);
                box-shadow: 0 0 10px rgba(180, 248, 200, 0.1);
            }

            .performer-select-card img {
                width: 40px;
                height: 40px;
                border-radius: 50%;
                margin-right: 10px;
                object-fit: cover;
            }

        .performer-name {
            font-size: 14px;
            color: white;
            font-weight: 500;
        }

        .check-icon {
            position: absolute;
            top: 8px;
            right: 8px;
            color: var(--accent-cyan);
            opacity: 0;
            transition: opacity 0.2s;
        }

        .performer-select-card.selected .check-icon {
            opacity: 1;
        }
    </style>
}