@model GlobalFests.ViewModels.EventsViewModel;


<div class="page-container">
    <div class="action-row">
        <h1 style="color:white; font-size: 32px;">Browse Events</h1>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-action="Create" class="btn-main" style="width: auto; padding: 0 25px;">
                <i class="fas fa-plus-circle"></i> Create Event
            </a>
        }
    </div>

    <!-- search bar  -->
    <div class="filter-bar">
        <form asp-action="Index" method="get">
            <div class="filter-grid">
                <!-- Title -->
                <div class="custom-input-group">
                    <i class="fas fa-search input-icon"></i>
                    <input type="text" asp-for="Search.Title" class="form-control-custom" placeholder="Title..." />
                </div>

                <!-- City -->
                <div class="custom-input-group">
                    <i class="fas fa-map-marker-alt input-icon"></i>
                    <input type="text"  asp-for="Search.City" class="form-control-custom" placeholder="City..." />
                </div>

                <!-- Country -->
                <div class="custom-input-group">
                    <i class="fas fa-globe input-icon"></i>
                    <select asp-for="Search.CountryId"
                            asp-items="@(Model.Countries != null ? new SelectList(Model.Countries, "Id", "CountryName") : null)"
                            class="form-control-custom">
                        <option value="">All Countries</option>
                    </select>
                </div>

                <!-- Type -->
                <div class="custom-input-group">
                    <i class="fas fa-music input-icon"></i>
                    <select asp-for="Search.TypeId"
                            asp-items="@(Model.EventTypes != null ? new SelectList(Model.EventTypes, "Id", "Type") : null)"
                            class="form-control-custom">
                        <option value="">All Types</option>
                    </select>
                </div>
            </div>

            <div class="filter-grid">
                <!-- Price Range -->
                <div class="custom-input-group">
                    <span style="color:#666;  margin-right:5px;"> $  </span>
                    <input type="number" asp-for="Search.MinPrice"  class="form-control-custom" min="0" max="100000000"  placeholder="Min" />
                    <span style="color:#666; margin-right:5px;">$</span>
                    <input type="number" asp-for="Search.MaxPrice"  class="form-control-custom" min="0" max="100000000"  placeholder="Max" />
                </div>

                <!-- Dates -->
                <div class="custom-input-group">
                    <i class="fas fa-calendar-alt input-icon"></i>
                    <!-- Поле "З" -->
                    <input type="text" asp-for="Search.StartDateFrom" id="dateFrom" class="form-control-custom" placeholder="Date From" />
                </div>

                <div class="custom-input-group">
                    <i class="fas fa-calendar-check input-icon"></i>
                    <!-- Поле "По" -->
                    <input type="text" asp-for="Search.StartDateTo" id="dateTo" class="form-control-custom" placeholder="Date To" />
                </div>


                <div style="display:flex; gap:10px;">
                    <button type="submit" class="btn-main" style="flex:2;">Search</button>
                    <a asp-action="Index" class="btn-main btn-secondary-custom" style="flex:1; justify-content:center; display:flex;">
                        <i class="fas fa-redo"></i>
                    </a>
                </div>
            </div>
        </form>
    </div>

    <!-- events  -->
    @if (Model.Events?.Items?.Any() == true)
    {
        <p class="grid-container__sub-title">Found @Model.Events.Items.Count event(s)</p>

        <div class="grid-container">
            @foreach (var eventItem in Model.Events.Items)
            {
                <div class="event-card">
                    <div class="card-img-placeholder">
                        <img src="@(string.IsNullOrEmpty(eventItem.Poster) ? $"https://ui-avatars.com/api/?name={eventItem.Title}&background=random" : eventItem.Poster)" alt="Poster">
                    </div>
                    <div class="card-details">
                        <div class="event-date">@eventItem.StartDate.ToString("MMM dd, yyyy")</div>
                        <h3 class="event-title">@eventItem.Title</h3>

                        <div style="display:flex; justify-content:space-between; align-items:flex-start;">
                            <div class="event-meta">
                                <i class="fas fa-map-marker-alt"></i> @eventItem.City, @eventItem.CountryName <br />
                                <span style="font-size:12px; color:#666;">By @eventItem.OrganizerName</span>
                            </div>
                            <div class="event-price">
                                @(eventItem.TicketPrice.HasValue && eventItem.TicketPrice > 0 ? "$" + eventItem.TicketPrice.Value.ToString("N0") : "Free")
                                <i class="fa-solid fa-arrow-right event-card__arrow"></i>
                            </div>
                        </div>

                        <a asp-action="Details" asp-route-id="@eventItem.Id" class="card-link"></a>
                    </div>
                </div>
            }
        </div>

        @if (Model.Events.HasNextPage)
        {
            <a asp-action="Index"
               asp-route-Search.Title="@(Model.Search?.Title ?? "" )"
               asp-route-Search.City="@Model.Search.City"
               asp-route-Search.CountryId="@Model.Search.CountryId"
               asp-route-Search.TypeId="@Model.Search.TypeId"
               asp-route-cursorDate="@Model.Events.NextCursorDate"
               asp-route-cursorId="@Model.Events.NextCursorId"
               class="btn-main btn-secondary-custom">
                Load More
            </a>
        }
    }
    else
    {
        <div style="text-align: center; padding: 60px; color: #888;">
            <i class="fas fa-ghost fa-3x" style="margin-bottom: 20px;"></i>
            <h3>No events found</h3>
            <p>Try adjusting your search criteria.</p>
        </div>
    }
</div>
@section Scripts {
    <!-- Підключаємо Flatpickr -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link rel="stylesheet" href="https://npmcdn.com/flatpickr/dist/themes/dark.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            // Налаштування для поля "Дата По" (спочатку)
            const dateTo = flatpickr("#dateTo", {
                dateFormat: "Y-m-d",
                theme: "dark",
                allowInput: true // Дозволяє вводити вручну, якщо треба
            });

            // Налаштування для поля "Дата З"
            const dateFrom = flatpickr("#dateFrom", {
                dateFormat: "Y-m-d",
                theme: "dark",
                allowInput: true,
                onChange: function (selectedDates, dateStr, instance) {
                    // КОЛИ ЗМІНЮЄТЬСЯ "ДАТА З":
                    // Встановлюємо мінімальну дату для "Дата По",
                    // щоб не можна було вибрати кінець раніше початку.
                    dateTo.set('minDate', dateStr);
                }
            });

            // (Опціонально) Якщо сторінка завантажилась вже з вибраною датою "З",
            // треба оновити обмеження для "По" одразу.
            if (document.getElementById('dateFrom').value) {
                dateTo.set('minDate', document.getElementById('dateFrom').value);
            }
        });
    </script>
}