@model GlobalFests.ViewModels.EventsViewModel;
@using Microsoft.AspNetCore.Mvc.Localization
@using GlobalFests.Helpers
@inject IHtmlLocalizer<SharedResource> Localizer
<div class="page-container">
    <div class="action-row">
        <h1 style="color:white; font-size: 32px;">@Localizer["Browse Events"]</h1>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-action="Create" class="btn-main" style="width: auto; padding: 0 25px;">
                <i class="fas fa-plus-circle"></i> @Localizer["Create Event"]
            </a>
        }
    </div>

    <!-- search bar  -->
    <div class="search-panel" style="margin-bottom: 40px;">
        <form asp-action="Index" method="get" id="searchForm">

        <!-- Primary Row: Title, Dates, Type, Search Button -->
        <div class="search-row primary-row">

            <!-- Title Search -->
            <div class="input-group search-text">
                <i class="fas fa-search"></i>
                    <input type="text" asp-for="Search.Title" placeholder="@Localizer["Find your next event, performer..."]" />
            </div>

            <!-- Date Range  -->
            <div class="input-group date-group" style="flex: 1.5;">
                <i class="fas fa-calendar-alt"></i>
                <!-- from -->
                    <input type="text" asp-for="Search.StartDateFrom" id="dateFrom" placeholder="@Localizer["Start date"]" style="text-align: center;" />
                <span class="separator"></span>
                <!-- to" -->
                    <input type="text" asp-for="Search.StartDateTo" id="dateTo" placeholder="@Localizer["End date"]" style="text-align: center;" />
            </div>

           
            <!-- Type -->
            <div class="custom-input-group">
                <i class="fas fa-music input-icon"></i>
                <select asp-for="Search.TypeId"
                        asp-items="@(Model.EventTypes != null ? new SelectList(Model.EventTypes, "Id", "Type") : null)"
                        class="form-control-custom">
                        <option value="">@Localizer["All Types"]</option>
                </select>
            </div>
            <!-- Genre -->
            <div class="custom-input-group">
                    <i class="fas fa-theater-masks input-icon"></i>
                <select asp-for="Search.GenreId"
                        asp-items="@(Model.Genres != null ? new SelectList(Model.Genres, "Id", "Genre1") : null)"
                        class="form-control-custom">
                        <option value="">@Localizer["All Genres"]</option>
                </select>
            </div>

            <!-- Search Button -->
                <button type="submit" class="search-btn">@Localizer["Search"]</button>
        </div>

        <!-- Secondary Row: Price, Country, City -->
        <div class="search-row secondary-row">

            <!-- Price Range -->
            <div class="input-group price-group">
                <i class="fas fa-dollar-sign"></i>
                    <input type="number" asp-for="Search.MinPrice" min="0" placeholder="@Localizer["Min price"]" />
                <span style="color:#444;">-</span>
                    <input type="number" asp-for="Search.MaxPrice" min="0" placeholder="@Localizer["Max price"]" />
            </div>

            <!-- City Input -->
            <div class="input-group dropdown-group">
                <i class="fas fa-city"></i>
                    <input type="text" asp-for="Search.City" placeholder="@Localizer["City name..."]" />
            </div>

            <!-- Country -->
            <div class="custom-input-group">
                <i class="fas fa-globe input-icon"></i>
                <select asp-for="Search.CountryId"
                        asp-items="@(Model.Countries != null ? new SelectList(Model.Countries, "Id", "CountryName") : null)"
                        class="form-control-custom">
                        <option value="">@Localizer["All Countries"]</option>
                </select>
            </div>
                <!-- Sorting  -->
                <div class="custom-input-group" style="min-width: 180px;">
                    <i class="fas fa-sort-amount-down"></i>
                    <select asp-for="Search.SortOrder"
                            asp-items="Html.GetEnumSelectList<SortState>()"
                            id="sortSelect" class="form-control-custom">
                    </select>
                </div>
            <!-- Reset   -->
                <a asp-action="Index" class="input-group" style="width: 50px; flex: 0; justify-content: center; cursor: pointer; text-decoration: none;" title="@Localizer["Reset Filters"]">
                <i class="fas fa-redo" style="margin: 0; color: #777;"></i>
            </a>
        </div>

    </form>
</div>

    <!-- events  -->
    @if (Model.Events?.Items?.Any() == true)
    {
        <p class="grid-container__sub-title">@Localizer["Found"] @Model.Events.Items.Count @Localizer["event(s)"]</p>

        <div class="grid-container">
            @foreach (var eventItem in Model.Events.Items)
            {
                <div class="event-card">
                    <div class="card-img-placeholder">
                        <img src="@(string.IsNullOrEmpty(eventItem.Poster) ? $"https://ui-avatars.com/api/?name={eventItem.Title}&background=random" : eventItem.Poster)" alt="Poster">
                    </div>
                    <div class="card-details">
                        <div class="event-date">@eventItem.StartDate.ToString("MMM dd, yyyy")</div>
                        <h3 class="event-title">@eventItem.Title</h3>

                        <div style="display:flex; justify-content:space-between; align-items:flex-start;">
                            <div class="event-meta">
                                <i class="fas fa-map-marker-alt"></i> @eventItem.City, @eventItem.CountryName <br />
                                <span style="font-size:12px; color:#666;">By @eventItem.OrganizerName</span>
                            </div>
                            <div class="event-price">
                                @(eventItem.TicketPrice.HasValue && eventItem.TicketPrice > 0 ? "$" + eventItem.TicketPrice.Value.ToString("N0") : "Free")
                                <i class="fa-solid fa-arrow-right event-card__arrow"></i>
                            </div>
                        </div>

                        <a asp-action="Details" asp-route-id="@eventItem.Id" class="card-link"></a>
                    </div>
                </div>
            }
        </div>

        @if (Model.Events.HasNextPage)
        {
            <div style="display:flex; justify-content:center; align-items:center; margin-top: 40px;">
            <a asp-action="Index"
                   asp-route-Search.Title="@(Model.Search?.Title)"
                   asp-route-Search.City="@Model.Search.City"
                   asp-route-Search.CountryId="@Model.Search.CountryId"
                   asp-route-Search.TypeId="@Model.Search.TypeId"
                   asp-route-Search.GenreId="@Model.Search.GenreId"
                   asp-route-Search.MinPrice="@Model.Search.MinPrice"
                   asp-route-Search.MaxPrice="@Model.Search.MaxPrice"
                   asp-route-Search.StartDateFrom="@Model.Search.StartDateFrom?.ToString("yyyy-MM-dd")"
                   asp-route-Search.StartDateTo="@Model.Search.StartDateTo?.ToString("yyyy-MM-dd")"
                   asp-route-Search.SortOrder="@Model.Search.SortOrder"
                   
                   asp-route-cursorValue="@Model.Events.NextCursorValue" 
                   asp-route-cursorId="@Model.Events.NextCursorId"
                   class="btn-main btn-secondary-custom" >
                    @Localizer["Load More"]
                </a>
            </div>
        }
    }
    else
    {
        <div style="text-align: center; padding: 60px; color: #888;">
            <i class="fas fa-ghost fa-3x" style="margin-bottom: 20px;"></i>
            <h3>No events found</h3>
            <p>Try adjusting your search criteria.</p>
        </div>
    }
</div>
@section Scripts {
    <!-- flatpickr -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link rel="stylesheet" href="https://npmcdn.com/flatpickr/dist/themes/dark.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            
            const dateTo = flatpickr("#dateTo", {
                dateFormat: "Y-m-d",
                theme: "dark",
                allowInput: true 
            });

           
            const dateFrom = flatpickr("#dateFrom", {
                dateFormat: "Y-m-d",
                theme: "dark",
                allowInput: true,
                onChange: function (selectedDates, dateStr, instance) {
                    
                    dateTo.set('minDate', dateStr);
                }
            });

           
            if (document.getElementById('dateFrom').value) {
                dateTo.set('minDate', document.getElementById('dateFrom').value);
            }

            const sortSelect = document.getElementById('sortSelect');
            const form = document.getElementById('searchForm');

            if (sortSelect && form) {
                sortSelect.addEventListener('change', function() {
                    form.submit();
                });
            }
        });
    </script>
}