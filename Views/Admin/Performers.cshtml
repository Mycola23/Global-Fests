@using GlobalFests.EFModels
@using GlobalFests.Helpers
@model GlobalFests.ViewModels.AdminPerformersIndexViewModel
@{
    ViewData["Title"] = "Manage Performers";
}

<div class="organizer__container organizer-dashboard admin-theme">
    <div class="dashboard-header" style="margin-bottom: 30px;">
        <h1 style="color: white; font-size: 32px;">Performers Management</h1>
        <p style="color: var(--text-muted);">View, edit and manage performers</p>
    </div>

    <partial name="_AdminDbNav" />
    <!-- FILTERS -->
    <div class="dash-glass-card search-card">
        <div class="admin-toolbar-wrapper">

            <!-- search form -->
            <form method="get" asp-action="Performers" class="admin-search-form">


                <div class="search-item title-group">
                    <label>Search by Title</label>
                    <div class="custom-input-group">
                        <i class="fas fa-search input-icon"></i>
                        <input type="text" name="SearchTerm" value="@Model.SearchTerm" asp-for="SearchTerm" class="form-control-custom" placeholder="Performer name...." />
                    </div>
                </div>


                <div class="search-item status-group">
                    <label>Status</label>
                    <div class="custom-input-group">
                        <select name="status" asp-items="Model.Statuses" asp-for="StatusFilter" class="form-control-custom">
                        </select>
                    </div>
                </div>

                <!--  search actions -->
                <div class="search-item actions-group">
                    <button type="submit" class="btn-dash btn-search">
                        Search
                    </button>

                    @if (!string.IsNullOrEmpty(Model.SearchTerm))
                    {
                        <a asp-action="Performers" class="btn-dash btn-reset">Reset</a>
                    }
                </div>
            </form>


            <div class="create-group">
                <a asp-controller="Organizer" asp-action="CreatePerformer" class="btn-dash btn-create">
                    <i class="fas fa-plus"></i> <span class="btn-text">New Performer</span>
                </a>
            </div>

        </div>
    </div>
    <!-- TABLE -->
    <div class="dash-glass-card">
        <div class="custom-table-container">
            <table class="custom-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Performer</th>
                        <th>Genres</th>
                        <th>Created</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Performers.Items)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>
                                <div style="display:flex; align-items:center; gap:10px;">
                                    <img src="@(string.IsNullOrEmpty(item.Avatar) ? $"https://ui-avatars.com/api/?name={item.Name}" : item.Avatar)" style="width:30px; height:30px; border-radius:50%; object-fit:cover;">
                                    <strong style="color: white;">@item.Name</strong>
                                </div>
                            </td>
                            <td>
                                @foreach (var g in item.Genres.Take(3))
                                {
                                    <span style="background: rgba(255,255,255,0.1); padding: 2px 6px; border-radius: 4px; font-size: 10px; margin-right: 3px;">@g.Genre1</span>
                                }
                            </td>
                            <td>@item.CreatedAt.ToString("MMM dd, yyyy")</td>
                            <td>
                                @{
                                    string color = item.Status == (int)Status.Approved ? "#b4f8c8" :
                                    item.Status == (int)Status.Rejected ? "#ff6b6b" : "#ffd800";
                                    string label = ((Status)item.Status).ToString();
                                }
                                <span style="color: @color; border: 1px solid @color; padding: 2px 8px; border-radius: 12px; font-size: 11px;">
                                    @label
                                </span>
                            </td>
                            <td>
                                <div style="display: flex; gap: 8px;">
                                    <!-- View Details  -->
                                    <a asp-controller="Organizer" asp-action="DetailsPerformer" asp-route-id="@item.Id" class="btn-icon-view" title="View">
                                        <i class="fas fa-eye"></i>
                                    </a>

                                    <!-- Edit  -->
                                    <a asp-controller="Organizer" asp-action="EditPerformer" asp-route-id="@item.Id" class="btn-icon-view" style="color: var(--accent-cyan);" title="Edit">
                                        <i class="fas fa-pen"></i>
                                    </a>

                                    @if (User.IsInRole("SuperAdmin"))
                                    {
                                        @*active*@
                                        <form asp-action="DeletePerformer" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this performer? This cannot be undone.');">
                                            <button type="submit" class="btn-icon-no" title="Delete">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        @*plug*@
                                        <button type="button" class="btn-icon-no" disabled
                                                style="opacity: 0.3; cursor: not-allowed;"
                                                title="Restricted: Only SuperAdmin can delete">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    }
                                   
                                    
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

       
        @if (Model.Performers.HasNextPage)
        {
            <div style="margin-top: 20px; display: flex; justify-content: center;">
                <a asp-action="Performers"
                   asp-route-searchTerm="@Model.SearchTerm"
                   asp-route-status="@Model.StatusFilter"
                   asp-route-cursorDate="@Model.Performers.NextCursorDate?.ToString("o")"
                   asp-route-cursorId="@Model.Performers.NextCursorId"
                   class="btn-dash" style="background: rgba(255,255,255,0.1); width: 200px; justify-content: center;">
                    Next Page <i class="fas fa-arrow-right" style="margin-left: 10px;"></i>
                </a>
            </div>
        }
    </div>
</div>

@section Styles {
    <style>
        .search-card {
            margin-bottom: 20px;
            padding: 20px;
        }

        .admin-toolbar-wrapper {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            align-items: flex-end;
        }

        /* --- FORM GRID --- */
        .admin-search-form {
            display: grid;
            grid-template-columns: 1fr 200px auto;
            gap: 15px;
            flex-grow: 1;
            align-items: end;
        }


            .admin-search-form label {
                color: #aaa;
                font-size: 12px;
                margin-bottom: 5px;
                display: block;
            }

            /* form btns */
            .admin-search-form .btn-dash {
                height: 50px;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 0 20px;
                font-weight: 600;
                white-space: nowrap;
            }

        .btn-search {
            background: var(--accent-cyan);
            color: #000;
            border: none;
        }

        .btn-reset {
            border: 1px solid #666;
            color: #ccc;
        }

        .btn-create {
            background: var(--accent-blue);
            color: white;
            border: none;
        }

        .actions-group {
            display: flex;
            gap: 10px;
        }

        /* adaptive */

        /* tablet  */
        @@media (max-width: 992px) {
            .admin-toolbar-wrapper {
                flex-direction: column;
                align-items: stretch;
            }

            .admin-search-form {
                grid-template-columns: 1fr 1fr;
            }

            .title-group {
                grid-column: span 2;
                
            }

            .status-group {
                grid-column: span 1;
            }

            .actions-group {
                grid-column: span 1;
            }

            .create-group {
                width: 100%;
            }

            .btn-create {
                width: 100%;
            }
        }

        /* phones */
        @@media (max-width: 600px) {
            .admin-search-form {
                grid-template-columns: 1fr;
                gap: 15px;
            }

            .title-group, .status-group, .actions-group {
                grid-column: span 1;
            }

            .actions-group {
                display: grid;
                grid-template-columns: 1fr 1fr;
            }

            .admin-search-form .btn-dash {
                width: 100%;
            }
        }
    </style>
}