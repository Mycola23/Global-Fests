@model GlobalFests.ViewModels.AdminUsersIndexViewModel
@{
    ViewData["Title"] = "Manage Users";
}
@if (TempData["SuccessMessage"] != null)
{
    <div style="margin-top:65px;background: rgba(180, 248, 200, 0.15); border: 1px solid #b4f8c8; color: #b4f8c8; padding: 15px; border-radius: 12px; margin-bottom: 20px;">
        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div style="margin-top:65px;background: rgba(255, 107, 107, 0.15); border: 1px solid #ff6b6b; color: #ff6b6b; padding: 15px; border-radius: 12px; margin-bottom: 20px;">
        <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
    </div>
}

<div class="organizer__container organizer-dashboard admin-theme">

    <div class="dashboard-header" style="margin-bottom: 30px;">
        <h1 style="color: white; font-size: 32px;">Users Management</h1>
        <p style="color: var(--text-muted);">View, edit and manage system users</p>
    </div>

    
    <partial name="_AdminDbNav" />

    <!-- SEARCH & ACTIONS BAR -->
    <div class="dash-glass-card search-card">
        <div class="admin-toolbar-wrapper">

            <!-- search form -->
            <form method="get" asp-action="Users" class="admin-search-form">


                <div class="search-item title-group">
                    <label>Search by Title</label>
                    <div class="custom-input-group">
                        <i class="fas fa-search input-icon"></i>
                        <input type="text" name="SearchTerm" value="@Model.SearchTerm" asp-for="SearchTerm" class="form-control-custom" placeholder="Username or Email..." />
                    </div>
                </div>


                @* <div class="search-item status-group">
                    <label>Status</label>
                    <div class="custom-input-group">
                        <select name="status" asp-items="Model.Statuses" asp-for="StatusFilter" class="form-control-custom">
                        </select>
                    </div>
                </div> *@

                <!--  search actions -->
                <div class="search-item actions-group">
                    <button type="submit" class="btn-dash btn-search">
                        Search
                    </button>

                    @if (!string.IsNullOrEmpty(Model.SearchTerm))
                    {
                        <a asp-action="Users" class="btn-dash btn-reset">Reset</a>
                    }
                </div>
            </form>


            <div class="create-group">
                <a asp-controller="Admin" asp-action="CreateUser" class="btn-dash btn-create">
                    <i class="fas fa-plus"></i> <span class="btn-text">New User</span>
                </a>
            </div>

        </div>
    </div>
    <!-- TABLE -->
    <div class="dash-glass-card">
        @if (Model.Users.Items.Any())
        {
            <div class="custom-table-container">
                <table class="custom-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>User</th>
                            <th>Role</th>
                            <th>Country</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.Users.Items)
                        {
                            <tr>
                                <td style="color: #888;">#@user.Id</td>
                                <td>
                                    <strong style="display: block; color: white; font-size: 14px;">@user.Username</strong>
                                    <span style="font-size: 12px; color: var(--text-muted);">@user.Email</span>
                                </td>
                                <td>
                                    <span style="background: rgba(255,255,255,0.1); padding: 4px 10px; border-radius: 20px; font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px;">
                                        @user.RoleName
                                    </span>
                                </td>
                                <td>@user.CountryName</td>
                                <td>
                                    @if (user.Verified)
                                    {
                                        <span style="color: #b4f8c8; font-size: 12px;"><i class="fas fa-check-circle"></i> Verified</span>
                                    }
                                    else
                                    {
                                        <span style="color: #ff6b6b; font-size: 12px;"><i class="fas fa-times-circle"></i> Unverified</span>
                                    }
                                </td>
                                <td style="font-size: 12px; color: #888;">@user.CreatedAt.ToString("MMM dd, yyyy")</td>
                                <td>
                                    <div style="display: flex; gap: 8px;">
                                        <a asp-action="EditUser" asp-route-id="@user.Id" class="btn-icon-view" title="Edit">
                                            <i class="fas fa-pen"></i>
                                        </a>
                                                          
                                        @if ( !User.IsInRole("SuperAdmin"))
                                        {
                                            @* not active *@
                                            <button type="button" class="btn-icon-no" style="opacity: 0.3; cursor: not-allowed;" title="Cannot delete: Item with your role">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            @*  active *@
                                            <form asp-action="DeleteUser" asp-route-id="@user.Id" method="post" onsubmit="return confirm('Are you sure? This action cannot be undone.');">
                                                <button type="submit" class="btn-icon-no"><i class="fas fa-trash"></i></button>
                                            </form>
                                        }
                                        
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- PAGINATION BUTTON -->
            @if (Model.Users.HasNextPage)
            {
                <div style="margin-top: 20px; display: flex; justify-content: center;">
                    <a asp-action="Users"
                       asp-route-searchTerm="@Model.SearchTerm"
                       asp-route-cursorDate="@Model.Users.NextCursorDate?.ToString("o")"
                       asp-route-cursorId="@Model.Users.NextCursorId"
                       class="btn-dash" style="background: rgba(255,255,255,0.1); width: 200px; justify-content: center;">
                        Next Page <i class="fas fa-arrow-right" style="margin-left: 10px;"></i>
                    </a>
                </div>
            }
        }
        else
        {
            <div style="text-align: center; padding: 40px; color: #888;">
                <i class="fas fa-users-slash" style="font-size: 40px; margin-bottom: 15px; opacity: 0.5;"></i>
                <p>No users found.</p>
            </div>
        }
    </div>
</div>

@section Styles {
    <style>
        .search-card {
            margin-bottom: 20px;
            padding: 20px;
        }

        .admin-toolbar-wrapper {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            align-items: flex-end;
        }

        /* --- FORM GRID --- */
        .admin-search-form {
            display: grid;
            grid-template-columns: 1fr 200px auto;
            gap: 15px;
            flex-grow: 1;
            align-items: end;
        }


            .admin-search-form label {
                color: #aaa;
                font-size: 12px;
                margin-bottom: 5px;
                display: block;
            }

            /* form btns */
            .admin-search-form .btn-dash {
                height: 50px;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 0 20px;
                font-weight: 600;
                white-space: nowrap;
            }

        .btn-search {
            background: var(--accent-cyan);
            color: #000;
            border: none;
        }

        .btn-reset {
            border: 1px solid #666;
            color: #ccc;
        }

        .btn-create {
            background: var(--accent-blue);
            color: white;
            border: none;
        }

        .actions-group {
            display: flex;
            gap: 10px;
        }

        /* adaptive */

        /* tablet  */
        @@media (max-width: 992px) {
            .admin-toolbar-wrapper {
                flex-direction: column;
                align-items: stretch;
            }

            .admin-search-form {
                grid-template-columns: 1fr 1fr;
            }

            .title-group {
                grid-column: span 2;
            }

            .status-group {
                grid-column: span 1;
            }

            .actions-group {
                grid-column: span 1;
            }

            .create-group {
                width: 100%;
            }

            .btn-create {
                width: 100%;
            }
        }

        /* phones */
        @@media (max-width: 600px) {
            .admin-search-form {
                grid-template-columns: 1fr;
                gap: 15px;
            }

            .title-group, .status-group, .actions-group {
                grid-column: span 1;
            }

            .actions-group {
                display: grid;
                grid-template-columns: 1fr 1fr;
            }

            .admin-search-form .btn-dash {
                width: 100%;
            }
        }
    </style>
}