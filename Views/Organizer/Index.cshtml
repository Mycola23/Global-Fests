@model GlobalFests.ViewModels.OrganizerPanelViewModel;

<div class="organizer__container organizer-dashboard">
    <!-- Верхні кнопки дій -->
    <div class="dashboard-actions">
        <a asp-controller="Events" asp-action="Create" class="btn-dash btn-cyan">
            <i class="fas fa-check-circle"></i> Create Event
        </a>
        <a asp-controller="Organizer" asp-action="CreatePerformer" class="btn-dash btn-purple">
            <i class="fas fa-plus-circle"></i> Add Performer
        </a>
    </div>

    <div class="dashboard-main-grid">
        <!-- ЛІВА КОЛОНКА -->
        <div class="grid-column-left">

            <!-- Запити виконавців -->
            <div class="dash-glass-card">
                <h3 class="dash-card-title">Performer Requests</h3>
                <div class="performer-list">
                    @if (Model.Performers != null && Model.Performers.Items.Any())
                    {
                        @foreach (var item in Model.Performers.Items)
                        {
                            <div class="performer-item">
                                @* Якщо аватара немає, використовуємо сервіс плейсхолдерів *@
                                <img src="@(string.IsNullOrEmpty(item.Avatar) ? $"https://ui-avatars.com/api/?name={item.Name}&background=random" : item.Avatar)" alt="Avatar">

                                <div class="performer-info">
                                    <span class="p-name">@item.Name</span>
                                    <span class="p-genre">
                                        @* Виводимо назви жанрів через кому *@
                                        @(item.Genres != null && item.Genres.Any()
                                            ? string.Join(", ", item.Genres.Select(g => g.Genre1))
                                            : "No genres")
                                    </span>
                                    <span class="p-status @(item.Approved ? "" : "review")">
                                        @(item.Approved ? "Approved" : "Pending")
                                    </span>
                                </div>

                                <a asp-controller="Organizer"
                                   asp-action="EditPerformer"
                                   asp-route-id="@item.Id"
                                   class="btn-edit-performer"
                                   style="text-decoration: none; display: flex; align-items: center; justify-content: center;">
                                    Edit
                                </a>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted">You haven't submitted any performer requests yet.</p>
                    }
                </div>
            </div>

            <!-- Мої створені події -->
            <div class="dash-glass-card">
                <h3 class="dash-card-title">My Created Events</h3>
                <div class="events-mini-grid">
                    @if (Model.Events != null && Model.Events.Items.Any())
                    {
                        @foreach (var ev in Model.Events.Items)
                        {
                            <div class="event-mini-card">
                                <div class="event-mini-thumb" style="background-image: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.3)), url('@(string.IsNullOrEmpty(ev.Poster) ? "https://picsum.photos/300/200?blur=2" : ev.Poster)')"></div>
                                <span class="event-mini-name" title="@ev.Title">@ev.Title</span>
                                <span class="p-status @(ev.Approved == true ? "" : "review")" style="font-size: 10px; display: block; margin-bottom: 5px;">
                                    @(ev.Approved == true ? "Approved" : "Pending")
                                </span>
                                <a asp-controller="Events"
                                   asp-action="Edit"
                                   asp-route-id="@ev.Id"
                                   class="btn-mini-edit"
                                   style="text-align: center; text-decoration: none; display: block;">
                                    Edit Event
                                </a>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted">No events found.</p>
                    }
                </div>
            </div>
        </div>

        <!-- ПРАВА КОЛОНКА -->
        <div class="grid-column-right">

            <!-- Статистика продажів -->
            <div class="dash-glass-card">
                <div class="stat-header">
                    <h3 class="dash-card-title">Event Statistics</h3>
                    <span class="stat-sub">Ticket Sales Trend</span>
                </div>
                <div class="stat-visual-row">
                    <div class="chart-mockup">
                        <i class="fas fa-chart-line"></i>
                    </div>
                    <div class="circle-progress-wrapper">
                        <div class="circle-chart">20%</div>
                        <span>Overall Sales</span>
                    </div>
                </div>
            </div>

            <!-- Рівень доходу та Вік -->
            <div class="stat-double-row">
                <div class="dash-glass-card">
                    <h3 class="dash-card-title">Revenue per Event</h3>
                    <div class="bar-chart-mock">
                        <div class="bar" style="height: 40%"></div>
                        <div class="bar" style="height: 80%"></div>
                        <div class="bar" style="height: 60%"></div>
                    </div>
                </div>
                <div class="dash-glass-card">
                    <h3 class="dash-card-title">Attendance</h3>
                    <div class="circle-chart small">30%</div>
                </div>
            </div>

            <!-- Підсумки -->
            <div class="dash-glass-card totals-card">
                <div class="totals-header">
                    <h3 class="dash-card-title">Total Events Created</h3>
                    <button class="btn-link-text">Edit Details</button>
                </div>
                <div class="totals-grid">
                    <div class="total-item">
                        <span class="total-label">Total Emails</span>
                        <span class="total-value">1159</span>
                        <button class="btn-link-text">Edit Details</button>
                    </div>
                    <div class="total-item">
                        <span class="total-label">Revenue Events</span>
                        <span class="total-value">23591</span>
                        <button class="btn-link-text">Export Data</button>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
