<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GlobalFests</title>

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />

    <link rel="stylesheet" href="~/css/main.css" asp-append-version="true" />
</head>
<body>
    <header class="gf-header">
        <div class="header-container">
            <!-- Logo -->
            <a class="gf-brand" asp-area="" asp-controller="Home" asp-action="Index">
                GlobalFests<span class="brand-sub">.com</span>
            </a>

            <!-- Center Curved Nav -->
            
            <nav class="gf-nav-center">
                <ul class="nav-list">
                    <li><a class="nav-link active" asp-controller="Home" asp-action="Index">Home</a></li>
                    <li><a class="nav-link" asp-controller="Events" asp-action="Index">Events</a></li>
                    <li><a class="nav-link" href="#">WorldMap</a></li>

                    @if (User.Identity?.IsAuthenticated != true)
                    {
                        <!-- Клас guest-btn змінено на nav-link, щоб відповідати стилю фото -->
                        <li><a class="nav-link" asp-controller="Account" asp-action="Login">Sign in</a></li>
                    }
                    else
                    {
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit" class="nav-link">Logout</button>
                            </form>
                        </li>
                    }
                </ul>
            </nav>


            <!-- User / Guest Section -->
            <div class="gf-user-actions">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="user-dropdown-container">
                        <button class="user-btn" id="userDropdownBtn">
                            @User.Identity.Name <i class="fas fa-chevron-down"></i>
                        </button>
                        <div class="dropdown-menu" id="userDropdownMenu">
                            <a asp-controller="Account" asp-action="Profile">Profile</a>
                            <a asp-controller="Events" asp-action="Create">Create Event</a>
                            <hr>
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit" class="logout-btn">Logout</button>
                            </form>
                        </div>
                    </div>
                }
                else
                {
                    <a href="#" class="guest-btn">guest <i class="fas fa-user-circle"></i></a>
                }
            </div>
        </div>
    </header>

    <!-- Main Content Wrapper -->
    <main role="main" class="main-content">
        @RenderBody()
    </main>

    <footer class="gf-footer">
        <div class="container">
            &copy; 2024 - GlobalFests - <a asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>