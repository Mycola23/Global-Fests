@model GlobalFests.DTOs.CursorResult<GlobalFests.DTOs.EventDto>
@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section with Background -->
<section class="hero-section">
    <div class="hero-overlay"></div>
    <div class="hero-content container">

        <h1 class="hero-title">
            Explore your place<br>to enjoy
        </h1>

        <!-- Search Bar Container -->
        <div class="search-panel">
            <form asp-controller="Events" asp-action="Index" method="get">

                <!-- Row 1: Main Search inputs -->
                <div class="search-row primary-row">
                    <div class="input-group search-text">
                        <i class="fas fa-search"></i>
                        <input type="text" name="SearchString" placeholder="Find your next event" />
                    </div>

                    <div class="input-group date-group">
                        <i class="fas fa-calendar-alt"></i>
                        <input type="text" placeholder="Start date" onfocus="(this.type='date')" onblur="(this.type='text')">
                        <span class="separator"></span>
                        <input type="text" placeholder="End date" onfocus="(this.type='date')" onblur="(this.type='text')">
                    </div>

                    <div class="input-group dropdown-group">
                        <i class="fas fa-magic"></i>
                        <select name="type">
                            <option value="" disabled selected>Types</option>
                            <option value="concert">Concert</option>
                            <option value="festival">Festival</option>
                        </select>
                        <i class="fas fa-chevron-down arrow"></i>
                    </div>

                    <div class="input-group dropdown-group">
                        <i class="fas fa-theater-masks"></i>
                        <select name="genre">
                            <option value="" disabled selected>Genres</option>
                            <option value="rock">Rock</option>
                            <option value="pop">Pop</option>
                        </select>
                        <i class="fas fa-chevron-down arrow"></i>
                    </div>

                    <button type="submit" class="search-btn">SEARCH</button>
                </div>

                <!-- Row 2: Filters -->
                <div class="search-row secondary-row">
                    <div class="input-group price-group">
                        <i class="fas fa-dollar-sign"></i>
                        <input type="number" min="0" max="100000000" placeholder="min price">
                        <input type="number" min="0" max="100000000" placeholder="max price">
                    </div>

                    <div class="input-group dropdown-group">
                        <i class="fas fa-map-marker-alt"></i>
                        <select>
                            <option value="" disabled selected>Popularity</option>
                        </select>
                        <i class="fas fa-chevron-down arrow"></i>
                    </div>

                    <div class="input-group dropdown-group">
                        <i class="fas fa-sort-amount-down"></i>
                        <select>
                            <option value="" disabled selected>Price sorting</option>
                        </select>
                        <i class="fas fa-chevron-down arrow"></i>
                    </div>

                    <div class="input-group dropdown-group">
                        <i class="fas fa-globe-americas"></i>
                        <select>
                            <option value="" disabled selected>Country</option>
                        </select>
                        <i class="fas fa-chevron-down arrow"></i>
                    </div>

                    <div class="input-group dropdown-group">
                        <i class="fas fa-city"></i>
                        <select>
                            <option value="" disabled selected>City</option>
                        </select>
                        <i class="fas fa-chevron-down arrow"></i>
                    </div>
                </div>
            </form>
        </div>
    </div>
</section>

<!-- Events Listing Section (Dark Theme) -->
<section class="events-section container">
    <div class="section-header">
        <h2>Featured Events</h2>
    </div>

    @if (Model != null && Model.Items != null && Model.Items.Any())
    {
        <div class="events-grid">
            @foreach (var eventItem in Model.Items)
            {
                <div class="event-card">
                    <!-- Placeholder for image if you have one, otherwise a gradient header -->
                    <div class="card-image-header"></div>
                    <div class="card-body">
                        <div class="card-date">
                            <i class="fas fa-calendar"></i> @eventItem.StartDate.ToString("MMM dd, yyyy")
                        </div>
                        <h3 class="card-title">@eventItem.Title</h3>
                        <div class="card-location">
                            <i class="fas fa-map-marker-alt"></i> @eventItem.City, @eventItem.CountryName
                        </div>
                        <div class="card-tags">
                            <span class="tag">@eventItem.EventType</span>
                        </div>
                        <div class="card-footer-row">
                            <div class="price">
                                @if (eventItem.TicketPrice.HasValue)
                                {
                                    <span>$@eventItem.TicketPrice.Value.ToString("N0")</span>
                                }
                                else
                                {
                                    <span class="free">Free</span>
                                }
                            </div>
                            <a asp-controller="Events" asp-action="Details" asp-route-id="@eventItem.Id" class="details-btn">Details</a>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (Model.Items.Count >= 12)
        {
            <div class="load-more-container">
                <a asp-controller="Events" asp-action="Index" class="load-more-btn">View All Events</a>
            </div>
        }
    }
    else
    {
        <div class="empty-state">
            <i class="fas fa-search"></i>
            <p>No events found right now.</p>
        </div>
    }
</section>