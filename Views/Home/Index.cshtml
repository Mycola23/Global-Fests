@model GlobalFests.ViewModels.HomeViewModel;
@using Microsoft.AspNetCore.Mvc.Localization
@{
    ViewData["Title"] = "Home";
    var randomId = Guid.NewGuid();

   
    var posterUrl = $"https://picsum.photos/seed/{randomId}/1920/1080";
    
    @inject IHtmlLocalizer<SharedResource> Localizer

}
<section class="hero-section">
    <div class="hero-overlay" style="background: linear-gradient(to bottom, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0.2) 50%, rgba(0,0,0,0.8) 100%), url('@posterUrl') no-repeat center center; background-size: cover;"></div>
    <div class="hero-content container">

        <h1 class="hero-title">
            @Localizer["main-phraze"]
        </h1>
        <!-- search bar container -->
        <div class="search-panel">
            <form asp-controller="Events" asp-action="Index" method="get">

                <!-- row  search inputs -->
                <div class="search-row primary-row">
                    <div class="input-group search-text">
                        <i class="fas fa-search"></i>
                        <input type="text" name="SearchString" placeholder="Find your next event" />
                    </div>

                    <div class="input-group date-group">
                        <i class="fas fa-calendar-alt"></i>
                        <input type="text" placeholder="Start date" onfocus="(this.type='date')" onblur="(this.type='text')">
                        <span class="separator"></span>
                        <input type="text" placeholder="End date" onfocus="(this.type='date')" onblur="(this.type='text')">
                    </div>

                    <div class="input-group dropdown-group">
                        <i class="fas fa-magic"></i>
                        <select name="type">
                            <option value="" disabled selected>Types</option>
                            <option value="concert">Concert</option>
                            <option value="festival">Festival</option>
                        </select>
                        <i class="fas fa-chevron-down arrow"></i>
                    </div>

                    <div class="input-group dropdown-group">
                        <i class="fas fa-theater-masks"></i>
                        <select name="genre">
                            <option value="" disabled selected>Genres</option>
                            <option value="rock">Rock</option>
                            <option value="pop">Pop</option>
                        </select>
                        <i class="fas fa-chevron-down arrow"></i>
                    </div>

                    <button type="submit" class="search-btn"> @Localizer["Search"]</button>
                </div>

                <!-- row  filters -->
                <div class="search-row secondary-row">
                    <div class="input-group price-group">
                        <i class="fas fa-dollar-sign"></i>
                        <input type="number" min="0" max="100000000" placeholder="min price">
                        <input type="number" min="0" max="100000000" placeholder="max price">
                    </div>

                    <div class="input-group dropdown-group">
                        <i class="fas fa-map-marker-alt"></i>
                        <select>
                            <option value="" disabled selected>Popularity</option>
                        </select>
                        <i class="fas fa-chevron-down arrow"></i>
                    </div>

                    <div class="input-group dropdown-group">
                        <i class="fas fa-sort-amount-down"></i>
                        <select>
                            <option value="" disabled selected>Price sorting</option>
                        </select>
                        <i class="fas fa-chevron-down arrow"></i>
                    </div>

                    <div class="input-group dropdown-group">
                        <i class="fas fa-globe-americas"></i>
                        <select>
                            <option value="" disabled selected>Country</option>
                        </select>
                        <i class="fas fa-chevron-down arrow"></i>
                    </div>

                    <div class="input-group dropdown-group">
                        <i class="fas fa-city"></i>
                        <select>
                            <option value="" disabled selected>City</option>
                        </select>
                        <i class="fas fa-chevron-down arrow"></i>
                    </div>
                </div>
            </form>
        </div>
    </div>
</section>

<!-- events  section  -->
<section class="events-section container">
    <div class="section-header">
        <h2>@Localizer["Featured Events"]</h2>
    </div>

    @if (Model != null && Model.SearchResult?.Items != null && Model.SearchResult.Items.Any())
    {
        <div class="grid-container">
            @foreach (var eventItem in Model.SearchResult.Items)
            {
                <div class="event-card">

                    <div class="card-img-placeholder">
                        <img src="@(string.IsNullOrEmpty(eventItem.Poster) ? $"https://ui-avatars.com/api/?name={eventItem.Title}&background=random" : eventItem.Poster)" alt="Poster">
                    </div>
                    <div class="card-body">
                        <div class="card-date">
                            <i class="fas fa-calendar"></i> @eventItem.StartDate.ToString("MMM dd, yyyy")
                        </div>
                        <h3 class="card-title">@eventItem.Title</h3>
                        <div class="card-location">
                            <i class="fas fa-map-marker-alt"></i> @eventItem.City, @eventItem.CountryName
                        </div>
                        <div class="card-tags">
                            <span class="tag">@eventItem.EventType</span>
                        </div>
                        <div class="card-footer-row">
                            <div class="price">
                                @if (eventItem.TicketPrice.HasValue)
                                {
                                    <span>$@eventItem.TicketPrice.Value.ToString("N0")</span>
                                }
                                else
                                {
                                    <span class="free">Free</span>
                                }
                            </div>
                            <a asp-controller="Events" asp-action="Details" asp-route-id="@eventItem.Id" class="details-btn">Details</a>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (Model.SearchResult.Items.Count >= 12)
        {
            <div class="load-more-container">
                <a asp-controller="Events" asp-action="Index" class="load-more-btn">@Localizer["View All Events"]</a>
            </div>
        }
    }
    else
    {
        <div class="empty-state">
            <i class="fas fa-search"></i>
            <p>No events found right now.</p>
        </div>
    }

    @if (Model.LocalEvents != null && Model.LocalEvents.Any())
    {
        <div class="slider-section">
            <div class="section-header">
                <h2 class="section-title">
                    <i class="fas fa-map-marker-alt" style="color: var(--accent-cyan);"></i> 
                    Events in @Model.UserCountryName
                </h2>
                <a href="#" class="view-all">View All</a>
            </div>
            
            <!-- swiper container -->
            <div class="swiper mySwiper">
                <div class="swiper-wrapper">
                    @foreach (var ev in Model.LocalEvents)
                    {
                        <div class="swiper-slide">
                            @await Html.PartialAsync("EventCardPartial", ev)
                        </div>
                    }
                </div>
                <div class="swiper-button-next"></div>
                <div class="swiper-button-prev"></div>
            </div>
        </div>
    }
    <!-- 2. BESTSELLING SLIDER -->
    @if (Model.BestSellingEvents != null && Model.BestSellingEvents.Any())
    {
        <div class="slider-section">
            <div class="section-header">
                <h2 class="section-title">
                    <i class="fas fa-trophy" style="color: #ffd700;"></i>  @Localizer["Best Selling"]
                </h2>
            </div>
            <div class="swiper mySwiper">
                <div class="swiper-wrapper">
                    @foreach (var ev in Model.BestSellingEvents)
                    {
                        <div class="swiper-slide">
                            @await Html.PartialAsync("EventCardPartial", ev)

                        
                            <div style="position: absolute; top: 10px; left: 10px; background: #ffd700; color: #000; padding: 2px 8px; border-radius: 4px; font-weight: bold; font-size: 12px; z-index: 2;">
                                #@(Model.BestSellingEvents.IndexOf(ev) + 1)
                            </div>
                        </div>
                    }
                </div>
                <div class="swiper-button-next"></div>
                <div class="swiper-button-prev"></div>
            </div>
        </div>
    }
    <!-- 2. TRENDING SLIDER -->
    <div class="slider-section">
        <div class="section-header">
            <h2 class="section-title">🔥 @Localizer["Trending Now"]</h2>
        </div>
        <div class="swiper mySwiper">
            <div class="swiper-wrapper">
                @foreach (var ev in Model.TrendingEvents)
                {
                    <div class="swiper-slide">
                        @await Html.PartialAsync("EventCardPartial", ev)
                    </div>
                }
            </div>
            <div class="swiper-button-next"></div>
            <div class="swiper-button-prev"></div>
        </div>
    </div>

    <!-- 3. UPCOMING SLIDER -->
    <div class="slider-section">
        <div class="section-header">
            <h2 class="section-title">📅 @Localizer["Upcoming Soon"]</h2>
        </div>
        <div class="swiper mySwiper">
            <div class="swiper-wrapper">
                @foreach (var ev in Model.UpcomingEvents)
                {
                    <div class="swiper-slide">
                        @await Html.PartialAsync("EventCardPartial", ev)
                    </div>
                }
            </div>
            <div class="swiper-button-next"></div>
            <div class="swiper-button-prev"></div>
        </div>
    </div>

</section>

@section Styles {
    <!-- Swiper CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />

    <style>
        .slider-section {
            margin-bottom: 50px;
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .section-title {
            font-size: 24px;
            font-weight: 700;
            color: white;
        }

        .view-all {
            color: var(--accent-cyan);
            font-size: 14px;
            text-decoration: none;
        }

        
        .swiper {
            width: 100%;
            padding: 10px 5px 40px 5px;
        }

        .swiper-slide {
            height: auto; 
            display: flex;
        }

        /* nav arrows */
        .swiper-button-next, .swiper-button-prev {
            color: var(--accent-cyan);
            background: rgba(0,0,0,0.5);
            width: 40px;
            height: 40px;
            border-radius: 50%;
            backdrop-filter: blur(5px);
        }

            .swiper-button-next::after, .swiper-button-prev::after {
                font-size: 18px;
                font-weight: bold;
            }
    </style>
}

@section Scripts {
    <!-- Swiper JS -->
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

    <script>
        var swiper = new Swiper(".mySwiper", {
            slidesPerView: 1,
            spaceBetween: 20,
            loop: true, 
            navigation: {
                nextEl: ".swiper-button-next",
                prevEl: ".swiper-button-prev",
            },
            breakpoints: {
                640: {
                    slidesPerView: 2,
                    spaceBetween: 20,
                },
                768: {
                    slidesPerView: 3,
                    spaceBetween: 30,
                },
                1024: {
                    slidesPerView: 4,
                    spaceBetween: 30,
                },
            },
            autoplay: {
                delay: 5000,
                disableOnInteraction: false,
                pauseOnMouseEnter: true
            }
        });
    </script>
}